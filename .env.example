# Copy to .env only if you need environment overrides. Never commit .env.
#
# Optional: supply a ViewMade MCP bearer token directly instead of the OAuth
# token file written by `cddocs viewmade login`. Keep this value secret.
# VIEWMADE_MCP_TOKEN=
#
# Required only for live render submission, in addition to --allow-live:
# CDDOCS_LIVE_CONFIRM=YES
#
# Optional override for the local state directory (default: <project>/state).
# CDDOCS_STATE_DIR=state
