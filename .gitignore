# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Local secrets and machine state
.env
state/*.db

# YouTube secrets - do not track
src/cddocs/youtube/youtube_token.json
src/cddocs/youtube/credentials.json
state/*.db-journal
state/*.db-wal
state/*.db-shm
state/viewmade-token.json
state/viewmade-oauth-client.json
state/viewmade-tools.json
state/viewmade-binding.json
state/viewmade-jobs/
state/oauth-*.json
state/review/
state/recovery-*.log

# Generated media (large, not source-controlled)
renders/
*.mp4
*.mov
*.wav.tmp

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Keep committed history export and placeholder files
!state/history.json
!state/.gitkeep
# Runtime state (local only)
youtube_token.json
*.bak-*
panel_settings.json
activity_log.json
production_pipeline.json
video_production_history.json
upload_history.json
content_registry.json
state/dashboard-render-*.json
state/dashboard-render-*.log

# Panel-created runtime packages and render reports
content/packages/panel-prj-*/
content/batches/*/render-report.json

# Repository-root scratch files (ad-hoc scripts and notes, not part of the app)
# These patterns are anchored to the root on purpose: tests/ and src/ must keep
# matching normal test and module discovery.
/check_*.py
/render_*.py
/test_*.py
/poll_video.py
/retry_render.py
/select_channel.py
/oauth_test.py
/create_test_video.py
/make_test_video.py
/*.txt
/*.bak
/*.bak-*
