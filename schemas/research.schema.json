{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cats-dogs-documentary.local/schemas/research.schema.json",
  "title": "Cats and Dogs Documentary research record",
  "description": "Evidence, uncertainty, claim checks, and source metadata for one package.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "question",
    "short_answer",
    "verification",
    "sources",
    "claim_checks",
    "open_questions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "package_id": {
      "$ref": "#/$defs/slug"
    },
    "question": {
      "type": "string",
      "minLength": 8
    },
    "short_answer": {
      "type": "string",
      "minLength": 10
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "researched_at",
        "method",
        "source_access",
        "myth_or_anecdote",
        "uncertainties"
      ],
      "properties": {
        "researched_at": {
          "$ref": "#/$defs/date"
        },
        "method": {
          "type": "string",
          "minLength": 30
        },
        "source_access": {
          "type": "string",
          "minLength": 15
        },
        "myth_or_anecdote": {
          "type": "string",
          "minLength": 20
        },
        "uncertainties": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 15
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "claim_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claim_check"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 10
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "authors",
        "year",
        "url",
        "accessed",
        "tier",
        "verified",
        "evidence",
        "limitations"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "type": {
          "type": "string",
          "minLength": 3
        },
        "title": {
          "type": "string",
          "minLength": 10
        },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "year": {
          "type": "integer",
          "minimum": 1800,
          "maximum": 2100
        },
        "journal": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "volume": {
          "type": "string",
          "minLength": 1
        },
        "issue": {
          "type": "string",
          "minLength": 1
        },
        "pages": {
          "type": "string",
          "minLength": 1
        },
        "doi": {
          "type": "string",
          "pattern": "^10\\."
        },
        "pmid": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "pmcid": {
          "type": "string",
          "pattern": "^PMC[0-9]+$"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "accessed": {
          "$ref": "#/$defs/date"
        },
        "tier": {
          "type": "integer",
          "enum": [1, 2, 3, 4]
        },
        "verified": {
          "const": true
        },
        "evidence": {
          "type": "string",
          "minLength": 60
        },
        "limitations": {
          "type": "string",
          "minLength": 30
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "tier": {
                "const": 1
              }
            },
            "required": ["tier"]
          },
          "then": {
            "anyOf": [
              {
                "required": ["doi"]
              },
              {
                "required": ["pmid"]
              }
            ]
          }
        }
      ]
    },
    "claim_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "verdict", "notes"],
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^c[0-9]+$"
        },
        "verdict": {
          "enum": ["supported", "partially_supported", "interpretation"]
        },
        "notes": {
          "type": "string",
          "minLength": 20
        }
      }
    }
  }
}
