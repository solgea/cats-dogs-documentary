{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cats-dogs-documentary.local/schemas/viewmade-binding.schema.json",
  "title": "Cats and Dogs Documentary ViewMade tool binding",
  "description": "Explicit mapping from render, status, and download operations to tools discovered from the official ViewMade MCP server.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider",
    "bound_at",
    "tools",
    "job_id_path",
    "provider_state_path",
    "success_states",
    "failure_states",
    "download_url_path",
    "download_file_path"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider": {
      "const": "viewmade"
    },
    "bound_at": {
      "type": "string",
      "format": "date-time"
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["render", "status", "download"],
      "properties": {
        "render": {
          "$ref": "#/$defs/bound_tool"
        },
        "status": {
          "$ref": "#/$defs/bound_tool"
        },
        "download": {
          "$ref": "#/$defs/bound_tool"
        }
      }
    },
    "job_id_path": {
      "$ref": "#/$defs/path"
    },
    "provider_state_path": {
      "$ref": "#/$defs/path"
    },
    "success_states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "failure_states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "download_url_path": {
      "$ref": "#/$defs/path"
    },
    "download_file_path": {
      "$ref": "#/$defs/path"
    }
  },
  "$defs": {
    "bound_tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "template"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "template": {
          "type": "object"
        }
      }
    },
    "path": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
