{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cats-dogs-documentary.local/schemas/batch.schema.json",
  "title": "Cats and Dogs Documentary batch manifest",
  "description": "A source-checked set of packages built, validated, deduplicated, and packaged together.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "created_at",
    "theme",
    "target_duration_s",
    "format",
    "status",
    "human_review_required",
    "packages",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "batch_id": {
      "$ref": "#/$defs/slug"
    },
    "created_at": {
      "type": "string",
      "format": "date"
    },
    "theme": {
      "type": "string",
      "minLength": 10
    },
    "target_duration_s": {
      "type": "number",
      "minimum": 30,
      "maximum": 60
    },
    "format": {
      "const": "youtube_shorts"
    },
    "status": {
      "const": "source-checked"
    },
    "human_review_required": {
      "const": true
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 10
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
