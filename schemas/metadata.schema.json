{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cats-dogs-documentary.local/schemas/metadata.schema.json",
  "title": "Cats and Dogs Documentary YouTube metadata",
  "description": "Manual-upload metadata for one Short. Presence of this file is not evidence of upload or sign-off.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "platform",
    "format",
    "title",
    "description",
    "hashtags",
    "tags",
    "category",
    "category_id",
    "language",
    "visibility",
    "made_for_kids",
    "contains_synthetic_media",
    "synthetic_media_disclosure",
    "educational_disclaimer",
    "manual_upload_required",
    "duration_s",
    "aspect_ratio",
    "resolution",
    "sources",
    "youtube_video_id",
    "youtube_url",
    "upload_status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "package_id": {
      "$ref": "#/$defs/slug"
    },
    "platform": {
      "const": "youtube"
    },
    "format": {
      "const": "short"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "minLength": 100,
      "maxLength": 5000,
      "pattern": "Illustrative, AI-assisted visuals; not documentary footage\\."
    },
    "hashtags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 15,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^#[A-Za-z0-9_]+$"
      },
      "contains": {
        "const": "#Shorts"
      }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "category_id": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "visibility": {
      "enum": ["private", "unlisted", "public"]
    },
    "made_for_kids": {
      "const": false
    },
    "contains_synthetic_media": {
      "const": true
    },
    "synthetic_media_disclosure": {
      "type": "string",
      "pattern": "[Nn]ot documentary footage"
    },
    "educational_disclaimer": {
      "type": "string",
      "minLength": 20
    },
    "manual_upload_required": {
      "const": true
    },
    "duration_s": {
      "type": "number",
      "minimum": 30,
      "maximum": 60
    },
    "aspect_ratio": {
      "const": "9:16"
    },
    "resolution": {
      "const": "1080x1920"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "citation", "url", "doi", "pmid"],
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "citation": {
            "type": "string",
            "minLength": 20
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "doi": {
            "type": ["string", "null"]
          },
          "pmid": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "youtube_video_id": {
      "type": "null"
    },
    "youtube_url": {
      "type": "null"
    },
    "upload_status": {
      "const": "not_uploaded_manual_only"
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
